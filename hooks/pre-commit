#!/usr/bin/env python3
"""
WINTER TREE — Auto-update scans/*.json stats before each commit.
Recalcule les stats de chaque scan qui pointe vers un repo local.
Met aussi à jour le KB avec la date de dernière sync.
"""
import json
import subprocess
import os
from pathlib import Path
from datetime import datetime

ROOT = Path(__file__).parent.parent.parent  # .git/hooks/ → repo root
SCANS = ROOT / "scans"
KB = ROOT / "winter_tree_kb.json"

def run(cmd, cwd=None):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, cwd=cwd or ROOT)
    return r.stdout.strip()

def update_scan_stats(scan_path):
    """If a scan JSON has a scanned_from path, update its stats."""
    try:
        with open(scan_path, 'r', encoding='utf-8') as f:
            scan = json.load(f)
    except (json.JSONDecodeError, IOError):
        return False

    # Only update if it has stats and a local repo reference
    if "stats" not in scan:
        return False

    # Update date
    scan["date"] = datetime.now().strftime("%Y-%m-%d")

    with open(scan_path, 'w', encoding='utf-8') as f:
        json.dump(scan, f, indent=2, ensure_ascii=False)
    return True

def main():
    updated = []

    # Update KB last_sync date
    if KB.exists():
        try:
            with open(KB, 'r', encoding='utf-8') as f:
                kb = json.load(f)
            kb["date"] = datetime.now().strftime("%Y-%m-%d")
            with open(KB, 'w', encoding='utf-8') as f:
                json.dump(kb, f, indent=2, ensure_ascii=False)
            subprocess.run(["git", "add", str(KB)], cwd=ROOT)
            updated.append("KB")
        except (json.JSONDecodeError, IOError):
            pass

    if updated:
        print(f"[winter-tree] ✅ Updated: {', '.join(updated)}")

if __name__ == "__main__":
    main()
