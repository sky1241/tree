#!/usr/bin/env python3
"""
WINTER TREE — Pre-commit hook pour le repo 'tree'.
Avant chaque commit:
  1. Met à jour la date du KB
  2. Re-scanne tous les repos locaux accessibles qui ont changé
  3. Stage les fichiers modifiés
"""
import json
import subprocess
import sys
import os
from pathlib import Path
from datetime import datetime

ROOT = Path(__file__).resolve().parent.parent.parent  # .git/hooks/ → repo root
SCRIPTS = ROOT / "scripts"
SCANS = ROOT / "scans"
KB = ROOT / "winter_tree_kb.json"
REPOS_JSON = ROOT / "repos.json"

def run(cmd, cwd=None):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, cwd=cwd or ROOT)
    return r.stdout.strip()

def update_kb_date():
    if not KB.exists():
        return False
    try:
        with open(KB, 'r', encoding='utf-8') as f:
            kb = json.load(f)
        kb["date"] = datetime.now().strftime("%Y-%m-%d")
        with open(KB, 'w', encoding='utf-8') as f:
            json.dump(kb, f, indent=2, ensure_ascii=False)
        run(f"git add \"{KB}\"")
        return True
    except:
        return False

def quick_scan_local_repos():
    """Scan rapide des repos locaux qui ont changé depuis le dernier scan."""
    if not REPOS_JSON.exists():
        return 0

    try:
        with open(REPOS_JSON, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except:
        return 0

    repos = [r for r in data.get("repos", []) if r.get("active", True)]
    updated = 0

    sys.path.insert(0, str(SCRIPTS))
    try:
        from engine import scan_repo
    except ImportError:
        print("[winter-tree] ⚠️ engine.py introuvable")
        return 0

    for repo in repos:
        name = repo["name"]
        local_path = repo.get("local_path", "")

        if not local_path or not Path(local_path).is_dir():
            continue

        # Skip tree itself
        if Path(local_path).resolve() == ROOT.resolve():
            continue

        scan_file = SCANS / f"{name}.json"

        # Check si repo a changé depuis dernier scan
        try:
            last_commit = run("git log -1 --format=%ci", cwd=local_path)
            if not last_commit:
                continue
            if scan_file.exists():
                scan_mtime = datetime.fromtimestamp(scan_file.stat().st_mtime)
                commit_str = last_commit.split("+")[0].split("-0")[0].strip()
                commit_time = datetime.fromisoformat(commit_str)
                if scan_mtime > commit_time:
                    continue
        except:
            pass

        try:
            tree = scan_repo(str(local_path))
            if tree:
                tree["scanned_from"] = local_path
                tree["scan_method"] = "local"
                with open(scan_file, 'w', encoding='utf-8') as f:
                    json.dump(tree, f, indent=2, ensure_ascii=False)
                run(f'git add "{scan_file}"')
                lines = tree.get("stats", {}).get("total_code_lines", 0)
                print(f"[winter-tree] 🔄 {name}: {lines:,}L")
                updated += 1
        except Exception as e:
            print(f"[winter-tree] ⚠️ {name}: {e}")

    return updated

def main():
    updated = []

    if update_kb_date():
        updated.append("KB")

    n = quick_scan_local_repos()
    if n > 0:
        updated.append(f"{n} repos")

    run('git add "scans/*.json"')

    if updated:
        print(f"[winter-tree] ✅ Synced: {', '.join(updated)}")

if __name__ == "__main__":
    main()
